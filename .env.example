# Public gateway listen address. Bind to localhost behind Caddy/Nginx.
GATEWAY_HOST=127.0.0.1
GATEWAY_PORT=8787

# Fixed TXBoard origin. Required. Use TLS in production.
TXBOARD_UPSTREAM_URL=https://your-txboard.example.com
# Set true ONLY for trusted internal HTTP origins, e.g. http://txboard:80 in a private Docker network.
TXBOARD_ALLOW_PRIVATE_HTTP=false

# Comma-delimited exact frontend origins including scheme and port.
# No wildcards. Required if browser sends an Origin header.
GATEWAY_ALLOWED_ORIGINS=https://your-txboard.example.com

# Network controls
GATEWAY_UPSTREAM_TIMEOUT_MS=8000
GATEWAY_MAX_RESPONSE_BYTES=1048576
GATEWAY_MAX_REQUEST_BYTES=16384

# Docker-only deployment. Network must exist and be private to your proxy.
GATEWAY_DOCKER_NETWORK=txboard-gateway-private
GATEWAY_IMAGE=txboard-gateway:local

# Enable encryption only with compose.crypto.yaml and persisted Docker JWK secret.
# See docs/app-crypto-preview.md. This is single-instance preview, not production.
GATEWAY_HPKE_SECRET_FILE=./secrets/gateway-hpke.json

# Required whenever GATEWAY_HPKE_MODE=optional. Redis must be private.
# GATEWAY_REDIS_URL=redis://gateway-redis:6379
# Opt-in: encrypted registration + email verification; defaults to off.
GATEWAY_ACCOUNT_WORKFLOWS_ENABLED=false
